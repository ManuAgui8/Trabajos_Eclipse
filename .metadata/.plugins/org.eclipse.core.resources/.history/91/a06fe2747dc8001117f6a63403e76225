import java.util.Scanner;

/**
 * Realiza un programa que lea un número positivo N y calcule y visualice su
factorial N!
Siendo el factorial:
0! = 1
1! = 1
2! = 2 * 1
3! = 3 * 2* 1
N! = N * (N-1) * (N-2)........* 3*2*1
 */
public class Ejercicio5 {

	public static void main(String[] args) {
		
		int num;
		int factorial = 0;
		Scanner teclado = new Scanner(System.in);
		
		//TODO: Forzar  al usuario a introducir un número positivo
		
		do {
			System.out.println("Introduce un número entero y positivo");
			num = teclado.nextInt();
		} while(num < 0);
		
		//TODO: Calcular el factorial del número do-while, while, for
		
		
		for (int i = 1; i <= num; i++) {
			factorial = num * (num-i);
		}
		
		System.out.println("El numero factorial de "+ num +" = "+ factorial);
		
		
		
		teclado.close();
	}
	
}
